# The app's own settings, for the web and worker containers. Copy to deploy/app.env on the
# server, fill in, then:
#   chmod 600 deploy/app.env
# deploy/app.env is git-ignored. Every value here is a PLACEHOLDER. Never commit or paste a real one.
# A setting left out uses the app's default; an unfinished placeholder stops the app at startup.
#
# Set by compose.yaml from deploy/.env, so NOT here: DEPLOYMENT_MODE, TRUSTED_HOSTS,
# OIDC_REDIRECT_URI, HOSTED_AUTH_DSN, HOSTED_TENANT_DSN, HOSTED_WORKER_DSN, HOSTED_BILLING_DSN,
# HOSTED_STORAGE_BACKEND, HOSTED_STORAGE_FILESYSTEM_ROOT.
#
# Keep a copy of the key below OFFLINE, apart from the backups: without
# HOSTED_STORAGE_FILESYSTEM_KEY no backed-up book can be read again.

# ==== Required to start ===========================================================================
# Encrypts every book file on disk (AES-256-GCM). `openssl rand -base64 32`
HOSTED_STORAGE_FILESYSTEM_KEY=GENERATE_WITH_openssl_rand_base64_32

# ==== Sign-in (one OpenID Connect provider, for example Auth0) ===================================
# The provider's exact issuer value, copied as the provider shows it in its discovery
# document, including a final slash if it has one (Auth0 does).
OIDC_ISSUER=https://OWNER_MUST_FILL_IN.example
# The app registered at the provider, with redirect address https://<domain>/api/auth/callback.
OIDC_CLIENT_ID=OWNER_MUST_FILL_IN
OIDC_CLIENT_SECRET=OWNER_MUST_FILL_IN
# OIDC_SCOPES=openid profile email
# OIDC_SIGNING_ALGORITHMS=RS256
# Session lifetime: a reader stays signed in 30 days at most, 14 days untouched, by default.
# SESSION_ABSOLUTE_TTL_SECONDS=2592000
# SESSION_IDLE_TTL_SECONDS=1209600

# ==== Storage =====================================================================================
# Book files: encrypted files on the server's `books` volume (set in compose.yaml). S3-compatible
# storage (HOSTED_S3_*) exists in the app but is not wired into this deployment.
# The largest EPUB a reader may upload, in bytes (128 MB). Cloudflare's free plan stops uploads
# above 100 MB before they reach the server.
# EPUB_MAX_UPLOAD_BYTES=134217728

# ==== Mothli's chat (the owner pays for its AI) ===================================================
# Mothli talks with readers inside a book and on the home screen. Every sentence it writes is
# checked before a reader sees it. That takes two AI accounts, both paid by you:
#   - the WRITER, which writes Mothli's replies: an OpenAI key (OPENAI_API_KEY) or, instead, an
#     Anthropic key (ANTHROPIC_API_KEY). Fill in one of the two.
#   - the CHECKER, "Jev", run by TypeSafe, which checks every sentence against what the reader has
#     read before it is shown: TYPESAFE_API_KEY.
# Fill in both keys and the chat is on, with the caps further down.
# Leave BOTH empty and the server still starts: readers read, keep their place, highlights, notes
# and bookmarks, and use the free library, and the app shows no chat anywhere.
# Fill in only one and the server refuses to start, naming the one that is missing.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=
#
# The switches below are what the chat needs, set to the values it works with. Leave them as they
# are; with no keys above they do nothing.
# Follow which pages a reader has actually read, so Mothli only ever talks about those (this one
# calls no AI, and stays on without keys).
READER_PAGE_CONTEXT=true
READER_READ_MAP=true
# Turn Jev on, and the chat that is checked by it. Replies arrive sentence by sentence, each one
# checked; hosted mode has no other kind of reply. Mothli's notes on finished chapters and what it
# remembers about a reader follow the chat (READER_STORY_NOTES=false or READER_RECOLLECTIONS=false
# turn either off); both are written by the job worker below.
JEV_ENABLED=true
READER_CONVERSATION_JEV=true
#
# Optional, with working defaults: the writer's models and address, and Jev's version and timeout.
# OPENAI_BASE_URL=
# LLM_LARGE_MODEL=
# LLM_CHEAP_MODEL=
# JEV_MODEL=jev-1.14.0
# JEV_TIMEOUT_SECONDS=5
# Where OPENAI_BASE_URL may point: the writer key is sent there with every reply.
# HOSTED_PROVIDER_ALLOWED_ORIGINS=https://api.openai.com,https://api.anthropic.com
# Story memory (ADR 0042, ADR 0044): who's who and the story so far, built by the job worker
# below for every reader's book, uploaded or from the free library, once per book file, one
# chapter ahead of their reading. It needs the chat's settings above, and with no AI keys it is
# off like the chat. Mothli pays for it (about $0.09 a chapter at today's prices) from the notes
# ceiling below, never a reader. Leave it on: the story panels promise to keep track of who's who.
HOSTED_STORY_MEMORY=true

# ==== The caps (US dollars, UTC days and months) ====================================================
# Per reader per day and per reader per month for talking with Mothli (where a reader has no limit
# of their own): a paying reader's two hidden guards, about 47 replies a day and 190 a month (the
# owner's numbers, ADR 0045, decided 23 November 2026); and for the whole platform per day,
# whatever any reader does ($15, the owner's number, ADR 0044). These are the app's defaults.
HOSTED_READER_USD_PER_DAY=1.00
HOSTED_READER_USD_PER_MONTH=4.00
HOSTED_PLATFORM_USD_PER_DAY=15.00
# A reader's two free weeks (ADR 0045), from their first question to Mothli: while they last the
# reader's day and month above are not applied, and one ceiling in dollars of their own chat since
# the start is (about 100 replies). After them the day and month above apply again. A reader whose
# own limits set a day or month (python -m app.hosted.limits) keeps those instead. Never shown to a
# reader. The app's defaults: no line is needed.
# HOSTED_FREE_DAYS=14
# HOSTED_FREE_USD=2.10
# A subscriber's first paid month (ADR 0045): for the 30 days after their first Paddle plan began,
# once per account, their chat since then may reach this in place of the month above (about 300
# replies); the day above stays. A gift has none. Never shown. The app's default.
# HOSTED_FIRST_PAID_MONTH_USD=6.30
# Story memory's own day ceiling for everyone, and the guards against abuse: how many new chapters
# one reader's reading may be the first to have built in a UTC day and in a UTC month, and of how
# many new book files a month the first chapter. The owner's numbers, and the app's defaults: no
# line is needed. Raise a guard if a real reader ever reaches one.
# HOSTED_STORY_MEMORY_USD_PER_DAY=10.00
# HOSTED_STORY_MEMORY_NEW_CHAPTERS_PER_DAY=30
# HOSTED_STORY_MEMORY_NEW_CHAPTERS_PER_MONTH=300
# HOSTED_STORY_MEMORY_NEW_FILES_PER_MONTH=5
# What Mothli does in the background for each reader (their own chapter notes, what it remembers
# of them) is Mothli's cost, never their allowance above: the day budget for all readers together,
# and the guards against abuse per reader per day and per month, far above real reading (60
# chapters marked read on day one use about $0.42). Past one, the work waits for tomorrow and the
# reader is told nothing. The app's defaults: no line is needed.
# HOSTED_BACKGROUND_USD_PER_DAY=3.00
# HOSTED_READER_BACKGROUND_USD_PER_DAY=1.00
# HOSTED_READER_BACKGROUND_USD_PER_MONTH=5.00
# Background work follows where a reader stands (ADR 0045): as above in their free weeks and while
# they pay, none once their free weeks are over and they do not pay. A reader who has signed up
# and never asked Mothli anything gets a warm-up: within so many days of sign-up, up to so many
# chapters of story memory their reading is the first to build and so much of chapter notes
# (about $2.75 at most a sign-up); past any, nothing until their first question. Never shown. The
# app's defaults: no line is needed.
# HOSTED_WARMUP_DAYS=30
# HOSTED_WARMUP_NEW_CHAPTERS=25
# HOSTED_WARMUP_NOTES_USD=0.50

# ==== Who runs Mothli (the public pages; ADR 0045 step 8) ========================================
# Printed as they are on the terms, privacy, refunds and contact pages that visitors and Paddle's
# reviewers read: your legal name (or your company's), the country you run it from, and the
# address readers write to. Until all three are set, those pages say Mothli is not open for
# sign-ups here, and the server refuses PADDLE_API_KEY below. Use your real details, never these.
# OPERATOR_LEGAL_NAME=OWNER_MUST_FILL_IN
# OPERATOR_COUNTRY=OWNER_MUST_FILL_IN
# OPERATOR_CONTACT_EMAIL=OWNER_MUST_FILL_IN

# ==== Paddle (the paid plan; ADR 0045) ============================================================
# Leave these commented out until the owner has a Paddle notification destination for
# https://<domain>/api/billing/paddle (the runbook says how). With no secret the route does not
# exist and nothing about plans changes. Paddle's account also sells another product: only
# messages about the price ids below are Mothli's; every other message is answered and ignored.
# Only the web process gets the secret, the API key, the client token and the checkout page:
# compose.yaml empties them for the worker and the purge, which never talk to Paddle.
# sandbox or production: which Paddle the ids and the secret below are from.
# PADDLE_ENVIRONMENT=sandbox
# The notification destination's secret key, as Paddle shows it once (pdl_ntfset_...).
# PADDLE_WEBHOOK_SECRET=OWNER_MUST_FILL_IN
# Mothli's own price ids (pri_...). Each line may hold several, separated by commas: when a price
# is replaced in Paddle, put the new id first and keep the old one, so readers on it stay paying.
# PADDLE_PRICE_MONTHLY=OWNER_MUST_FILL_IN
# PADDLE_PRICE_YEARLY=OWNER_MUST_FILL_IN
# How far, in seconds, a message's signed time may be from the server's clock. The app's default.
# PADDLE_WEBHOOK_TOLERANCE_SECONDS=300
# Paddle's API key, from the same Paddle as PADDLE_ENVIRONMENT, for subscribing, cancelling,
# keeping a plan, updating a card and the regular check (the runbook says which permissions it
# needs and when it expires). Needs PADDLE_WEBHOOK_SECRET above, and the three OPERATOR_ lines
# (who runs Mothli). Keep it like a password.
# PADDLE_API_KEY=OWNER_MUST_FILL_IN
# Mothli's own page for Paddle's payment links, on this server's own host: https://<domain>/ with
# nothing after the slash. Every checkout carries it, so Paddle's emails about a checkout come here
# and not to the account's default payment link (the other product's page). Its domain must be
# approved in Paddle (Website approval) first, or every checkout fails. Needed with PADDLE_API_KEY.
# PADDLE_CHECKOUT_URL=https://OWNER_MUST_FILL_IN/
# Paddle's client-side token, from the same Paddle (test_... for the sandbox, live_... for live),
# for the plan sheet: the reader's browser shows the prices and opens Paddle's checkout with it.
# Public by design, but set it here, never in the app. Needs PADDLE_API_KEY above.
# PADDLE_CLIENT_TOKEN=OWNER_MUST_FILL_IN

# ==== The job worker ==============================================================================
# The companion's job dispatcher (ADR 0041 part 6): it writes Mothli's chapter notes, what it
# remembers about readers and, with HOSTED_STORY_MEMORY, story memory. It needs the chat's keys
# above. The worker runs only with COMPOSE_PROFILES=worker in deploy/.env (the runbook says when);
# the web server ignores this line.
HOSTED_JOB_HANDLER=app.hosted.companion.jobs:CompanionJobs
