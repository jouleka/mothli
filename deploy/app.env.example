# The app's own settings, for the web and worker containers. Copy to deploy/app.env on the
# server, fill in, then:
#   chmod 600 deploy/app.env
# deploy/app.env is git-ignored. Every value here is a PLACEHOLDER. Never commit or paste a real one.
# A setting left out uses the app's default; an unfinished placeholder stops the app at startup.
#
# Set by compose.yaml from deploy/.env, so NOT here: DEPLOYMENT_MODE, TRUSTED_HOSTS,
# OIDC_REDIRECT_URI, HOSTED_AUTH_DSN, HOSTED_TENANT_DSN, HOSTED_WORKER_DSN,
# HOSTED_STORAGE_BACKEND, HOSTED_STORAGE_FILESYSTEM_ROOT.
#
# Keep a copy of the three keys below OFFLINE, apart from the backups: without
# HOSTED_STORAGE_FILESYSTEM_KEY no backed-up book can be read again.

# ==== Required to start ===========================================================================
# Wraps the keys of any AI key a reader stores. 32 random bytes, base64: `openssl rand -base64 32`
HOSTED_CREDENTIAL_MASTER_KEY=GENERATE_WITH_openssl_rand_base64_32
# A label for that key, changed when the key is rotated.
HOSTED_CREDENTIAL_KEY_VERSION=v1
# Encrypts every book file on disk (AES-256-GCM). `openssl rand -base64 32`
HOSTED_STORAGE_FILESYSTEM_KEY=GENERATE_WITH_openssl_rand_base64_32

# ==== Sign-in (one OpenID Connect provider; which one is not chosen yet) ==========================
# The provider's exact issuer address: HTTPS, no trailing slash.
OIDC_ISSUER=https://OWNER_MUST_FILL_IN.example
# The app registered at the provider, with redirect address https://<domain>/api/auth/callback.
OIDC_CLIENT_ID=OWNER_MUST_FILL_IN
OIDC_CLIENT_SECRET=OWNER_MUST_FILL_IN
# OIDC_SCOPES=openid profile email
# OIDC_SIGNING_ALGORITHMS=RS256
# Session lifetime: 8 hours absolute, 30 minutes idle by default (to be reconsidered for reading).
# SESSION_ABSOLUTE_TTL_SECONDS=28800
# SESSION_IDLE_TTL_SECONDS=1800

# ==== Storage =====================================================================================
# Book files: encrypted files on the server's `books` volume (set in compose.yaml). S3-compatible
# storage (HOSTED_S3_*) exists in the app but is not wired into this deployment.
# The largest EPUB a reader may upload, in bytes (128 MB). Cloudflare's free plan stops uploads
# above 100 MB before they reach the server.
# EPUB_MAX_UPLOAD_BYTES=134217728

# ==== The platform's AI (the owner pays) — names only =============================================
# None of these is needed yet: hosted mode turns on no feature that calls a model until ADR 0041
# part 5. Once one is set, startup requires the whole set to be valid. Leave them out until then.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_BASE_URL=
# LLM_LARGE_MODEL=
# LLM_CHEAP_MODEL=
# JEV_ENABLED=
# TYPESAFE_API_KEY=
# JEV_MODEL=jev-1.14.0
# JEV_TIMEOUT_SECONDS=5
# HOSTED_PROVIDER_ALLOWED_ORIGINS=https://api.openai.com,https://api.anthropic.com
# The older "paste your own key" screens; off.
# HOSTED_READER_KEYS=false

# ==== The caps (US dollars, UTC days and months) — TO BE CONFIRMED BY THE OWNER ===================
# Per reader per day, per reader per month (where a reader has no limit of their own), and for
# the whole platform per day, whatever any reader does. These are the app's defaults.
HOSTED_READER_USD_PER_DAY=0.10
HOSTED_READER_USD_PER_MONTH=2.00
HOSTED_PLATFORM_USD_PER_DAY=5.00

# ==== The job worker ==============================================================================
# The job dispatcher, from ADR 0041 part 6 (not built yet). The worker does not start without it.
# HOSTED_JOB_HANDLER=
