# Server settings for deploy/compose.yaml. Copy to deploy/.env on the server, fill in, then:
#   chmod 600 deploy/.env
# deploy/.env is git-ignored. It is read by Docker Compose only; no container receives the whole
# file: each gets the one or two values it needs (see compose.yaml).
# Every value here is a PLACEHOLDER. Never commit or paste a real one anywhere.

# ---- The owner must fill in --------------------------------------------------------------------
# The domain readers open, without https:// (for example reader.example.org). The app accepts
# requests for this name only, and sign-in returns to https://<domain>/api/auth/callback.
MOTHLI_DOMAIN=OWNER_MUST_FILL_IN.example

# The Cloudflare tunnel's token (Cloudflare dashboard > Zero Trust > Networks > Tunnels).
CLOUDFLARE_TUNNEL_TOKEN=OWNER_MUST_FILL_IN

# ---- Database passwords: generate each with `openssl rand -hex 32` ---------------------------------
# Letters, digits, - and _ only, 32 characters or more (the deployment refuses anything else).
# The superuser: reaches only the database container and the one-shot migration step.
POSTGRES_PASSWORD=GENERATE_WITH_openssl_rand_hex_32
# The migration owner: owns the tables; used only by the migration step.
MOTHLI_DB_OWNER_PASSWORD=GENERATE_WITH_openssl_rand_hex_32
# Sign-in role (web).
MOTHLI_DB_AUTH_PASSWORD=GENERATE_WITH_openssl_rand_hex_32
# Reader role, row-level security enforced (web, worker).
MOTHLI_DB_TENANT_PASSWORD=GENERATE_WITH_openssl_rand_hex_32
# Job worker role (worker).
MOTHLI_DB_WORKER_PASSWORD=GENERATE_WITH_openssl_rand_hex_32
# Audit log reader (command-line tools only).
MOTHLI_DB_AUDIT_PASSWORD=GENERATE_WITH_openssl_rand_hex_32
# Reader limits (command-line tools only).
MOTHLI_DB_OPERATOR_PASSWORD=GENERATE_WITH_openssl_rand_hex_32
# Erases accounts 30 days after the reader asked (the daily purge only).
MOTHLI_DB_PURGE_PASSWORD=GENERATE_WITH_openssl_rand_hex_32

# ---- Backups to Cloudflare R2 (runbook step 4) ----------------------------------------------------
# Only the backup container receives these. From Cloudflare: R2 > Manage API tokens > the token
# made for the bucket mothli-protected-backups alone ("Object Read & Write"). Cloudflare shows
# all three once, when the token is made.
# The address under "Use jurisdiction-specific endpoints for S3 clients", for example
# https://0123456789abcdef0123456789abcdef.r2.cloudflarestorage.com (no bucket name after it).
MOTHLI_BACKUP_S3_ENDPOINT=https://OWNER_MUST_FILL_IN.r2.cloudflarestorage.com
MOTHLI_BACKUP_ACCESS_KEY_ID=OWNER_MUST_FILL_IN
MOTHLI_BACKUP_SECRET_ACCESS_KEY=OWNER_MUST_FILL_IN
# The bucket, if it is not called mothli-protected-backups.
# MOTHLI_BACKUP_BUCKET=mothli-protected-backups

# ---- Usually left as they are -------------------------------------------------------------------
# Which optional parts run. "worker" once both AI keys in app.env are filled in (Mothli's chat):
# it writes Mothli's notes on finished chapters, what it remembers about readers, and its notes
# on every book's story (who's who and the story so far).
# COMPOSE_PROFILES=worker
# A label for the images built from this checkout (for example the git commit).
# MOTHLI_RELEASE=local
# The private range for proxy and web, the part of it handed out automatically, and the proxy's
# fixed address outside that part. Change all three only if the range is already used.
# MOTHLI_EDGE_SUBNET=10.88.88.0/29
# MOTHLI_EDGE_DYNAMIC_RANGE=10.88.88.0/30
# MOTHLI_PROXY_ADDRESS=10.88.88.6
# MOTHLI_DB_NAME=mothli
# MOTHLI_DB_ROLE_PREFIX=mothli
