# Mothli's proxy (ADR 0041 part 9). Plain HTTP on the private network: the Cloudflare tunnel
# (cloudflared) is the only way in and carries TLS from the reader to Cloudflare and from
# Cloudflare to this server. Nothing here listens on the server's public address.
{
	admin off
	persist_config off
	auto_https off
	servers {
		timeouts {
			# An EPUB upload may be up to 128 MB.
			read_body 5m
			read_header 30s
			# A whole response: a streamed reply can last well over a minute (the slowest
			# measured: 69.5 s) and a book download on a slow line much longer.
			write 30m
			idle 5m
		}
	}
}

:8080 {
	# The same browser defences the backend sets on its own responses (app/main.py
	# _SecurityHeaders), here for the static app too. A backend test keeps the two equal.
	header {
		Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'self'; frame-src 'self' blob: https://buy.paddle.com https://sandbox-buy.paddle.com; form-action 'self'; script-src 'self' https://cdn.paddle.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://cdn.paddle.com https://sandbox-cdn.paddle.com; img-src 'self' data: blob:; font-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self' https://api.paddle.com https://sandbox-api.paddle.com; worker-src 'self' blob:"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	request_body {
		max_size 140MB
	}

	handle /api/* {
		# No `encode` here: compressing would hold back a streamed reply's chunks. Caddy flushes
		# a text/event-stream (or any response of unknown length) at once on its own.
		# `flush_interval -1` is deliberately not set: it would keep a reply running, and
		# paying, after the reader has gone.
		reverse_proxy web:8000 {
			transport http {
				dial_timeout 5s
				response_header_timeout 2m
				read_timeout 10m
				write_timeout 5m
				# Shorter than the backend's keep-alive (75 s), so a reused connection is
				# never one the backend is closing.
				keepalive 30s
			}
		}
	}

	# The front page and the public pages (ADR 0045 step 8), for a request with no session cookie:
	# the backend writes them out as readable HTML (app/hosted/public_pages.py), for visitors and
	# programs that run no JavaScript; the app then takes over in the browser. A signed-in reader's
	# request never goes there: the app's own page below, as before. If the backend cannot answer,
	# the app's own page all the same.
	@readable {
		path / /terms /privacy /refunds /contact
		not header_regexp Cookie (^|;\s*)__Host-litlet-session=
	}
	handle @readable {
		encode zstd gzip
		reverse_proxy web:8000 {
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
			@failed status 5xx
			handle_response @failed {
				root * /srv/mothli
				rewrite * /index.html
				header Cache-Control "no-cache"
				file_server
			}
		}
	}

	handle {
		root * /srv/mothli
		# The public pages (ADR 0045 step 8) are the app's own page, at addresses of their own.
		@pages path /terms /privacy /refunds /contact
		rewrite @pages /index.html
		encode zstd gzip
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@unhashed not path /assets/*
		header @unhashed Cache-Control "no-cache"
		file_server
	}

	# The backend not reachable at all: the readable pages fall back to the app's own page.
	handle_errors 502 503 504 {
		@unanswered path / /terms /privacy /refunds /contact
		handle @unanswered {
			root * /srv/mothli
			rewrite * /index.html
			header Cache-Control "no-cache"
			file_server
		}
	}
}
