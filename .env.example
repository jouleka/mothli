# Copy this file to `.env`. The copy is ignored by Git.
# The offline stub is deterministic and makes the local UI usable without sending content to a provider.
ALLOW_STUB=true
DATA_DIR=data
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# To use a provider, uncomment the relevant values and set ALLOW_STUB=false.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_BASE_URL=
# EMBED_PROVIDER=openai-compatible
# EMBED_API_KEY=
# EMBED_BASE_URL=
# Terra uses low effort for extraction/selection and medium for synthesis/evidence review.
# LLM_CHEAP_MODEL=gpt-6.1-terra
# LLM_LARGE_MODEL=gpt-6.1-terra
# EMBED_MODEL=text-embedding-3-small

# Local testing with your ChatGPT account: install Codex CLI and run `codex login`.
# LLM_TRANSPORT=codex-local
# Current-page chat needs no embeddings: use EMBED_PROVIDER=stub to avoid embedding API calls.
# Keep production credentials in a separate configuration that local testing does not load.
# The CLI adapter is slower and cannot enforce a provider-side output-token cap.
# It validates outputs and rejects excess usage after completion. Never enable in hosted mode.

# Faster local source selection and positive-evidence audits, with independent GPT answer review.
# Jev is a typed-decision API; it does not replace the models that write prose or extract chapters.
# JEV_ENABLED=true
# Supply TYPESAFE_API_KEY in the server process environment (never the browser).
# On the Windows account with the existing encrypted Jev credential, use this instead:
# JEV_WINDOWS_CREDENTIAL=true
# JEV_MODEL=jev-1.13.0
# JEV_SELECTION_ENABLED=true
# JEV_EVIDENCE_ENABLED=true
# JEV_PARTIAL_EVIDENCE_ENABLED=false
# Optional negative-only chapter screen; accepted memory still needs the full GPT review.
# JEV_EXTRACTION_ENABLED=false
# Optional chapter-grounded alias nomination; an independent cited GPT review must agree.
# Guarded identity mode disables embedding-only merges; uncertainty leaves identities separate.
# JEV_IDENTITY_ENABLED=false
# Keep recap review on GPT: the opt-in Jev recap reviewer did not improve cold recap latency.
# JEV_RECAP_ENABLED=false
# Prepare a guarded recap after durable ingestion; bounded background queue, normal spend ceilings.
# RECAP_PREWARM=true
# Broader complete-answer preparation: diverse, premise-reviewed questions from completed memory.
# READER_ANSWER_CACHE=true
# READER_PREPARE_ENABLED=true
# READER_PREPARE_MAX_QUESTIONS=8
# READER_PREPARE_MAX_USD_PER_BOOK=0.25

# Opt-in conversation pipeline: draft from every bounded candidate, then overlap independent
# positive-evidence and own-citation reviews. Oversized inputs retain full source selection.
# READER_CONVERSATION_PIPELINE=true
# READER_CONVERSATION_REVIEW_EFFORT=low
# Exact confirmed page prefixes, independent of chapter extraction (local reader only).
# READER_PAGE_CONTEXT=true
# Local page-context preview only: false defers automatic paid chapter-memory backfill.
# Explicit ingestion remains available; production keeps the default true.
# READER_MEMORY_INGEST=true
# Local page chat: Jev evidence preparation/checks + Terra drafting and bounded escalation.
# Requires JEV_ENABLED, a configured Jev key and JEV_MODEL=jev-1.14.0.
# Validated local preview enables this; keep production unchanged.
# READER_CONVERSATION_JEV=false
# Optional local typed turn routing, brief scene recaps and lower draft effort.
# READER_CONVERSATION_ROUTING=false
# READER_CONVERSATION_DRAFT_EFFORT=medium
# Optional native OpenAI Fast processing for reader calls only; premium pricing, same ceilings.
# READER_FAST_MODE=true

# Hosted mode is experimental and requires the full validated configuration documented in
# backend/app/config.py. Never reuse local/development credentials for a hosted deployment.

# "Pick a classic" fetches a curated public-domain EPUB from Project Gutenberg when a reader adds
# one. Nothing is fetched otherwise. Set to false for an offline or air-gapped install.
CLASSICS_ENABLED=true
